# Primary LLM provider: "claude_cli" or "codex_cli"
LLM_PROVIDER=claude_cli

# Timeout (seconds) for LLM calls
LLM_TIMEOUT_SECONDS=45

# Fallback provider used if primary fails: "codex_cli" or "claude_cli"
LLM_FALLBACK_PROVIDER=codex_cli

# Optional Codex CLI model override (only used when codex_cli is selected)
CODEX_MODEL=
